# Host directory with your shots. Mounted at the same path inside the container,
# so paths from Nuke Read nodes work unchanged. Jobs can only read/write here
# (and under ./data).
PROJECTS_DIR=/home/des/projects

# Run as your user so outputs aren't root-owned (`id -u` / `id -g`).
UID=1000
GID=1001

DA3_PORT=8000
# LAN address to publish on (plus localhost). Other interfaces, e.g. VPNs, stay closed.
DA3_LAN_IP=192.168.10.7
HF_CACHE_DIR=/home/des/.cache/huggingface

# PyTorch CUDA build. cu124 + torch 2.6.0 needs an NVIDIA driver that supports CUDA 12.4+
# (driver 550 or newer). Check with: nvidia-smi
TORCH_CUDA=cu124
TORCH_VERSION=2.6.0
BAKE_MODELS=da3-small da3-base da3-large

# Web UI login (user / shared password). Required before Higgsfield submissions.
UI_USER=da3
UI_PASSWORD=

# Higgsfield API credentials (console.higgsfield.ai). Leave empty until you have them.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Account concurrency limit (see the Higgsfield console)
HIGGSFIELD_MAX_CONCURRENT=4

# Set to 1 on a machine without internet (all three models are baked into the image)
HF_HUB_OFFLINE=0
